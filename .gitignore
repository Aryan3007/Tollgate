# One file for the whole repo (root, backend/ and frontend/).
# Patterns without a leading slash match at any depth.

# ── Secrets and local config ────────────────────────────────────────────────
# Real values live in .env files, which are never committed. The .env.example
# files document every variable and are the only ones that are.
.env
.env.*
!.env.example
*.pem
# Local MCP server config (it can hold tokens and local URLs)
.mcp.json

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output (regenerated by `pnpm build`) ──────────────────────────────
dist/
build/
out/
.next/
.vercel
*.tsbuildinfo
# Written by `next dev` / `next build`
next-env.d.ts

# ── Tests, coverage and caches ──────────────────────────────────────────────
coverage/
.nyc_output/
.vitest/
.cache/
.eslintcache
.turbo/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Editors and OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Generated media ─────────────────────────────────────────────────────────
# Output of the launch-video tool (a rendered mp4 and its working files).
# Remove this line if you want the video in the repo.
brag-output/
