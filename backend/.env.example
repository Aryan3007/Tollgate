NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=4mb
# Defaults to on outside production
SWAGGER_UI_ENABLED=

DATABASE_URL=postgres://tollgate:<POSTGRES_PASSWORD>@localhost:5432/tollgate
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
KEY_PEPPER=
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_MAX=20
# Defaults to true in production
COOKIE_SECURE=

# env: keys below. azure: Key Vault secrets provider-openai / provider-anthropic / provider-groq
SECRET_STORE=env
AZURE_KEYVAULT_URL=
PROVIDER_KEY_OPENAI=
PROVIDER_KEY_ANTHROPIC=
PROVIDER_KEY_GROQ=
UPSTREAM_TTFB_TIMEOUT_MS=30000

# Used only by `pnpm db:seed`
ADMIN_EMAIL=admin@tollgate.local
ADMIN_PASSWORD=
# Point at the mock provider (pnpm mock:provider -> http://127.0.0.1:4010/v1) to develop without spending money
OPENAI_BASE_URL=https://api.openai.com/v1
